# Backend remoto contra el emulador local Floci.
#
# Es la misma idea que `backend.tf.example` (estado en S3 y locks en DynamoDB),
# pero apuntando al emulador en vez de a AWS. Sirve para practicar el flujo
# completo de estado remoto sin cuenta de AWS.
#
# Requisitos: el emulador tiene que estar corriendo y el bucket y la tabla
# tienen que existir:
#
#   aws s3 mb s3://invoice-tf-state
#   aws dynamodb create-table --table-name invoice-tf-locks \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST
#
# Después: reemplazar el bloque `backend "local"` de `versions.tf` por este, y
# correr `terraform init -input=false`.

terraform {
  backend "s3" {
    bucket         = "invoice-tf-state"
    key            = "invoice-api-practice/dev/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "invoice-tf-locks"

    # Credenciales falsas: el emulador no las valida.
    access_key = "test"
    secret_key = "test"

    # El emulador no implementa STS ni la validación de cuenta.
    skip_credentials_validation = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true

    # `endpoints` es un argumento (no un bloque) en el backend S3 actual.
    endpoints = {
      s3       = "http://localhost:4566"
      dynamodb = "http://localhost:4566"
    }
  }
}
